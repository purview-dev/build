{
	"$comment": [
		"The single source of truth for package.json validation. Both the data-driven TUnit suite",
		"(PackageJsonScenarioTests) and the `just package-matrix` recipe, which runs each case through",
		"the real `purview-build package-validate` CLI, read this file. Adding a rule means appending",
		"cases here, not writing test code.",
		"",
		"Fields: profile (PackageJson:Profile, default Auto), projectType (Build:ProjectType),",
		"packsNuGetPackages (Build:RunPack), runTests/runLint, additionalRequiredFields, disabledRules,",
		"treatWarningsAsErrors, packageJson (the file's contents), and the expected succeeded/exitCode/",
		"profile plus the exact rule IDs that must fail and warn. 'errors' and 'warnings' are rule IDs,",
		"not messages, so rewording a finding is not a fixture change."
	],
	"scenarios": [
		{
			"name": "dotnet-nuget-complete-passes",
			"why": "A .NET repository that packs NuGet packages: the file carries the release version and full metadata.",
			"profile": "Auto",
			"projectType": "DotNet",
			"packsNuGetPackages": true,
			"packageJson": {
				"name": "contoso.widgets",
				"version": "1.2.3",
				"description": "Widget primitives for Contoso applications.",
				"license": "MIT",
				"author": { "name": "Contoso" },
				"homepage": "https://contoso.example/widgets",
				"bugs": { "url": "https://contoso.example/widgets/issues" },
				"repository": { "type": "git", "url": "git+https://contoso.example/widgets.git" },
				"keywords": ["widgets", "contoso"],
				"private": true
			},
			"expected": {
				"succeeded": true,
				"exitCode": 0,
				"profile": "DotNetNuGet",
				"errors": [],
				"warnings": []
			}
		},
		{
			"name": "dotnet-solution-without-packing-passes",
			"why": "A .NET repository that packs nothing resolves to DotNetSolution; the same file still passes.",
			"profile": "Auto",
			"projectType": "DotNet",
			"packsNuGetPackages": false,
			"packageJson": {
				"name": "contoso.tools",
				"version": "1.2.3",
				"description": "Tooling for Contoso applications.",
				"license": "MIT",
				"author": { "name": "Contoso" },
				"homepage": "https://contoso.example/tools",
				"bugs": { "url": "https://contoso.example/tools/issues" },
				"repository": { "type": "git", "url": "git+https://contoso.example/tools.git" },
				"keywords": ["tooling"],
				"private": true
			},
			"expected": {
				"succeeded": true,
				"exitCode": 0,
				"profile": "DotNetSolution",
				"errors": [],
				"warnings": []
			}
		},
		{
			"name": "web-package-complete-passes",
