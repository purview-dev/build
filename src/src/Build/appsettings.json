{
	"Build": {
		"ProjectType": "DotNet",
		"Solution": "src/Product.slnx",
		"Configuration": "Release",
		"ArtifactsFolder": "artifacts",
		"RunTests": true,
		"TestRoot": "src/tests",
		"TestPatterns": "*Tests.csproj",
		"TestProjects": "*",
		"TestFramework": "TUnit",
		"TestFilter": "/*/*/*/*/",
		"RunLint": true,
		"RunPack": true,
		"ValidatePack": true,
		"WebInstallCommand": "bun install",
		"WebBuildCommand": "bun run build",
		"WebLintCommand": "bun run lint",
		"WebFormatCheckCommand": "bun run format:check",
		"WebTestCommand": "bun run test",
		"WebBuildOutput": "src/dist"
	},
	"PackValidation": {
		"RequireSymbolPackage": true,
		"RequireSymbolFiles": true,
		"RequireSourceLink": false,
		"RequireDeterministic": false,
		"RequiredCompilerFlags": [],
		"RequiredContent": {},
		"ForbiddenContent": {}
	},
	"NuGet": {
		"FeedUrl": "https://api.nuget.org/v3/index.json",
		"TrustedPublishing": false
	},
	"PublishLocalNuGet": {
		"LocalFeedPath": "",
		"OverwriteExistingPackages": true,
		"ShutdownDotnetBuilderServer": true,
		"ClearPackageCache": true
	},
	"GitHub": {
		"AccessToken": null,
		"ProductHeader": "Purview.Build.Pipeline"
	},
	"Release": {
		"Mode": "None",
		"UploadArtifacts": false
	}
}