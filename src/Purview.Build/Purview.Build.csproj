<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>purview-build</ToolCommandName>
		<PackageId>Purview.Build</PackageId>
		<Authors>purview-dev</Authors>
		<Description>Shared Modular Pipelines build/test/release tool for purview-dev repositories.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/purview-dev/build</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ModularPipelines" Version="[3.2.8,4.0.0)" />
		<PackageReference Include="ModularPipelines.DotNet" Version="[3.2.8,4.0.0)" />
		<PackageReference Include="ModularPipelines.Git" Version="[3.2.8,4.0.0)" />
		<PackageReference Include="ModularPipelines.GitHub" Version="[3.2.8,4.0.0)" />
		<PackageReference Include="NuGet.Packaging" Version="[7.9.0,8.0.0)" />
		<PackageReference Include="NuGet.Versioning" Version="[7.9.0,8.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="../../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>