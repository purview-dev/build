{
	"Build": {
		"Solution": "src/Build.slnx",
		"TestRoot": "src/tests",
		"TestPatterns": "*Tests.csproj"
	},
	"PackValidation": {
		"RequireSymbolPackage": true,
		"RequireSymbolFiles": true,
		"RequireSourceLink": true,
		"RequireDeterministic": true,
		"RequireExplicitContent": false,
		"RequiredCompilerFlags": [
			"optimization=release"
		],
		"RequiredContent": {
			"purview.build": [
				"tools/**/Purview.Build.dll",
				"tools/**/appsettings.json",
				"README.md",
				"purview-logo-light.png"
			]
		},
		"ForbiddenContent": {
			"*": [
				"**/*.pdb"
			]
		}
	},
	"Release": {
		"Mode": "None"
	}
}